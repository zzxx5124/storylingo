# ==================================================
# AI 分析提供者設定（二選一）
# ==================================================

# 方案 A：NVIDIA NIM（免費，推薦）
#   key 取得：https://build.nvidia.com/settings/api-keys  （開頭為 nvapi-）
#   新帳號有免費 credits，OpenAI 相容端點。
AI_PROVIDER=nvidia
AI_API_KEY=nvapi-你的NVIDIAkey
AI_MODEL=deepseek-ai/deepseek-v4-flash
AI_MODEL_FALLBACK=deepseek-ai/deepseek-v4-pro
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# 方案 B：OpenAI
#   取消下方註解並改 AI_PROVIDER=openai
# OPENAI_API_KEY=sk-你的key
# OPENAI_MODEL=gpt-4o-mini

# 伺服器埠
PORT=8000

# development | production
APP_ENV=development
DEV_AUTH_BYPASS=false
PUBLIC_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REDIS_URL=
TTS_PROVIDER_ID=0
TTS_SECRET_KEY=
TTS_EDGE_ENABLED=true

# ---------- 管理員登入 ----------
# 設定後：未登入者為訪客（只能看有可播放章節的書並播放，無法上傳/分析/改聲線）
# production 必填；development 也建議設定
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------- Authentication / OAuth（production enable 前需另行完成 config gate） ----------
AUTH_MAIL_BACKEND=console
AUTH_MAIL_FROM=mailbox@example.com
AUTH_MAIL_FROM_NAME=語閱 StoryLingo
AUTH_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
# AUTH_MAIL_BACKEND=fake 僅供測試；production 未配置正式 mail provider 會回報 NOT_CONFIGURED
# Microsoft 365 / Graph（僅在完成租戶管理員同意與 secret manager 注入後啟用）
# AUTH_MAIL_BACKEND=microsoft_graph
# AUTH_MAIL_M365_TENANT_ID=
# AUTH_MAIL_M365_CLIENT_ID=
# AUTH_MAIL_M365_CLIENT_SECRET=
# AUTH_MAIL_M365_MAILBOX=mailbox@example.com
# AUTH_MAIL_M365_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# ---------- F5-TTS 自訂聲線（可選） ----------
# 1) 把 f5-tts 的 myenv 複製到專案根目錄 (myenv/)
